# LLM provider — optional. With nothing set, src/llm.py uses the keyword
# classifier (tests/test_classifier.py) and raw message templates.
#
# Usage:  cp .env.example .env  →  edit  →  export $(grep -v '^#' .env | xargs)

# LLM_MODEL is optional for either provider; src/llm.py picks a default when
# it is unset.
# LLM_MODEL=


# --- Anthropic ---------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here


# --- Any OpenAI-compatible endpoint ------------------------------------------
# Groq, Together, OpenRouter, vLLM, LM Studio, or Ollama's /v1.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-api-key-here


# --- Force the model off without unsetting keys -------------------------------
# LLM_PROVIDER=deterministic

# Request timeout in seconds.
# LLM_TIMEOUT_S=8
